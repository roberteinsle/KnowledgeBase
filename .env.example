APP_NAME="App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=de
DISPLAY_TIMEZONE=Europe/Berlin
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL aus docker-compose.yml (docker compose up -d db)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=app

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Lokal landen Mails (und damit Anmeldelinks) im Log: storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Erster Admin (nie fest im Code)
ADMIN_EMAIL=

# MCP server: allowed OAuth callback origins (comma-separated)
MCP_REDIRECT_DOMAINS=https://claude.ai,https://claude.com,http://localhost
